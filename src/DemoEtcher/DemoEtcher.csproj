<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>10.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>DemoEtcher</RootNamespace>
    <AssemblyName>DemoEtcher</AssemblyName>
    <Version>0.3.0</Version>
    <Product>DemoEtcher (IronFA 입문 실습 장비)</Product>
    <Company>IronAutomation</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- IronGEM과 gRPC로 이야기하는 라이브러리. grpc_csharp_ext.x86/x64.dll이 출력 폴더에 함께 복사됩니다. -->
    <PackageReference Include="IronAutomation.IronGEM.Connector" Version="0.1.5" />
  </ItemGroup>

</Project>
